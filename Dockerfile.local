# =============================================================================
# SGLang + FlashInfer 0.6.14 (Official Wheel Build)
# =============================================================================
# Build context: /opt/models (parent of sglang/)
#
#   docker build -f sglang/Dockerfile.local -t sglang:local /opt/models
#
# Mirrors are enabled by default. Disable with --build-arg USE_MIRRORS=0.
# =============================================================================

FROM m.daocloud.io/docker.io/lmsysorg/sglang:dev-cu13 AS base

# ---------------------------------------------------------------------------
# Mirror configuration
# ---------------------------------------------------------------------------
ARG USE_MIRRORS=1
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG HF_ENDPOINT=https://hf-mirror.com
ARG MAX_JOBS=16
ARG TORCH_CUDA_ARCH_LIST="9.0;10.0;10.3"

ENV HF_ENDPOINT=${HF_ENDPOINT} \
    HF_HUB_ENABLE_HF_TRANSFER=1

# ---------------------------------------------------------------------------
# Pip mirror
# ---------------------------------------------------------------------------
RUN if [ "$USE_MIRRORS" = "1" ] && [ -n "$PIP_INDEX_URL" ]; then \
      python3 -m pip config set global.index-url "$PIP_INDEX_URL"; \
    fi

# ---------------------------------------------------------------------------
# Install official FlashInfer 0.6.14 from pip wheel
# cuda-tile>=1.4.0 is a new dep of flashinfer 0.6.14, only on PyPI (not in
# flashinfer.ai/whl nor mirrors), so we pre-install it from PyPI first.
# ---------------------------------------------------------------------------
ARG FLASHINFER_VERSION=0.6.14
ARG FLASHINFER_WHL_INDEX=https://flashinfer.ai/whl

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip uninstall -y flashinfer flashinfer_python flashinfer_cubin flashinfer_jit_cache cuda-tile 2>/dev/null || true \
    && python3 -m pip install cuda-tile>=1.4.0 --index-url https://pypi.org/simple/ \
    && python3 -m pip install flashinfer-cubin==${FLASHINFER_VERSION} --index-url ${FLASHINFER_WHL_INDEX} \
    && python3 -m pip install flashinfer-python==${FLASHINFER_VERSION} \
         --index-url ${FLASHINFER_WHL_INDEX} \
         --extra-index-url https://pypi.org/simple/

# ===========================================================================
# Stage 2: SGLang (built from local source)
# ===========================================================================
FROM base AS sglang_builder

ARG USE_MIRRORS
ARG HF_ENDPOINT

COPY sglang/ /src/sglang/

RUN --mount=type=cache,target=/root/.cache/pip \
    cd /src/sglang/python \
    && python3 -m pip install --no-build-isolation -e ".[all]"

# ---------------------------------------------------------------------------
# Force-reinstall official FlashInfer 0.6.14 (sglang ".[all]" may pull a
# different flashinfer version from PyPI which overwrites ours).
# ---------------------------------------------------------------------------
ARG FLASHINFER_VERSION=0.6.14
ARG FLASHINFER_WHL_INDEX=https://flashinfer.ai/whl

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip uninstall -y flashinfer flashinfer_python flashinfer_cubin flashinfer_jit_cache cuda-tile 2>/dev/null || true \
    && python3 -m pip install cuda-tile>=1.4.0 --index-url https://pypi.org/simple/ \
    && python3 -m pip install flashinfer-cubin==${FLASHINFER_VERSION} --index-url ${FLASHINFER_WHL_INDEX} \
    && python3 -m pip install flashinfer-python==${FLASHINFER_VERSION} \
         --index-url ${FLASHINFER_WHL_INDEX} \
         --extra-index-url https://pypi.org/simple/

RUN mkdir -p /root/.cache/huggingface /root/.cache/sglang /root/.cache/torch

# ===========================================================================
# Stage 3: Gateway/Router (rebuilt from local source)
# ===========================================================================
# The base image ships sglang-router 0.3.2 with tool-parser 1.0.0, which
# lacks deepseekv4 DSML support.  Rebuild from the local gateway source
# (Cargo.toml already pinned to tool-parser 1.3.0) so the parser registry
# includes DeepSeekV4ToolParser.
# ===========================================================================
FROM sglang_builder AS gateway_builder

ARG MAX_JOBS
ARG USE_MIRRORS
ARG PIP_INDEX_URL

# Configure cargo sparse mirror for faster crate downloads in China
RUN mkdir -p /root/.cargo && printf '\
[source.crates-io]\n\
replace-with = "rsproxy-sparse"\n\
[source.rsproxy]\n\
registry = "https://rsproxy.cn/crates.io-index"\n\
[source.rsproxy-sparse]\n\
registry = "sparse+https://rsproxy.cn/index/"\n\
[registries.rsproxy]\n\
index = "https://rsproxy.cn/crates.io-index"\n\
[net]\n\
git-fetch-with-cli = true\n\
' > /root/.cargo/config.toml

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install maturin

# Rebuild sglang_router Python bindings with the updated Cargo.toml.
# The gateway source lives inside the sglang repo at sgl-model-gateway/.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/src/sglang/sgl-model-gateway/target \
    git config --global http.proxy http://192.168.1.111:7890 \
    && git config --global https.proxy http://192.168.1.111:7890 \
    && cd /src/sglang/sgl-model-gateway/bindings/python \
    && CARGO_BUILD_JOBS=${MAX_JOBS} maturin build --release --out dist \
    && python3 -m pip install --force-reinstall --no-deps dist/*.whl \
    && git config --global --unset http.proxy \
    && git config --global --unset https.proxy

# ===========================================================================
# Stage 4: Runtime
# ===========================================================================
FROM gateway_builder AS runtime

ARG HF_ENDPOINT
ARG SGLANG_BUILD_COMMIT=unknown
ARG SGLANG_IMAGE_TAG=sglang:local

ENV HF_ENDPOINT=${HF_ENDPOINT} \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    SGLANG_BUILD_COMMIT=${SGLANG_BUILD_COMMIT} \
    SGLANG_IMAGE_TAG=${SGLANG_IMAGE_TAG}

LABEL org.opencontainers.image.source="https://github.com/sekfung/sglang" \
      org.opencontainers.image.revision="${SGLANG_BUILD_COMMIT}" \
      org.opencontainers.image.version="${SGLANG_IMAGE_TAG}"

WORKDIR /src/sglang

CMD ["/bin/bash"]
